# Telegram token from @BotFather
BOT_TOKEN="1234567890:replace_me"

# Numeric Telegram user IDs separated by commas
ALLOWED_USERS="123456789"

# Native local RCI endpoint available from Entware
RCI_URL="http://127.0.0.1:79/rci"

# Optional for future KeeneticOS releases with mandatory RCI tokens
RCI_TOKEN=""
RCI_TOKEN_HEADER="Authorization"
RCI_TOKEN_PREFIX="Bearer "

# System interface ID used when an input line omits the interface
DEFAULT_INTERFACE="u1Host"

PRIVATE_CHATS_ONLY="true"
LOG_LEVEL="INFO"
LOG_FILE="/opt/var/log/keenetic-routes-bot.log"
POLL_TIMEOUT="25"
REQUEST_TIMEOUT="15"

# KeeneticOS 5.1 limit for one FQDN object group
MAX_GROUP_ENTRIES="300"
